{
  "manifest_version": 3,
  "name": "AI Puzzle Assistant",
  "description": "Runs the AI puzzle assistant on the current page.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ai-puzzle-hotkeys.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Run AI Puzzle Assistant"
  },
  "commands": {
    "run-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Run AI Puzzle Assistant on the current page"
    }
  }
}
