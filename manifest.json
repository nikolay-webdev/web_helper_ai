{
  "manifest_version": 3,
  "name": "Web Helper AI",
  "description": "Ein lokaler KI-Assistent für Aufgaben auf Webseiten.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ai-puzzle-hotkeys.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Web Helper AI starten"
  },
  "commands": {
    "run-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Web Helper AI auf der aktuellen Seite starten"
    }
  }
}
